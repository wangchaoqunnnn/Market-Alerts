# ============================================
# 盘中异动监控系统 - 环境变量配置示例
# 使用方法：复制为 .env 后修改对应值
#   cp .env.example .env
# ============================================

# --------------------------------------------
# 基础服务配置
# --------------------------------------------

# 服务监听地址与端口（对应 server/main.ts 读取的 SERVER_HOST / SERVER_PORT）
# SERVER_HOST 必须是 0.0.0.0，否则容器只绑定 127.0.0.1，宿主机访问不到映射端口
# SERVER_PORT 需与 docker-compose.yml 的 "3000:3000" 端口映射保持一致
# 必填：否
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# 日志目录（应用写入 <LOG_DIR>/server.log）
# 容器内工作目录为 /app，默认 logs 即 /app/logs（Dockerfile 已创建并授权）
# 必填：否
LOG_DIR=/app/logs

# 兼容旧变量：服务代码不读取 PORT，仅 SERVER_PORT 生效，保留以免旧脚本报错
PORT=3000

# 运行环境
# 可选值：production / development
# 默认值：production
# 必填：否
NODE_ENV=production

# --------------------------------------------
# 数据库配置（docker-compose 内置 PostgreSQL 16）
# --------------------------------------------

# 数据库账号 / 密码 / 库名：compose 用它初始化 PostgreSQL 容器
# ⚠️ 生产环境务必修改 DB_PASSWORD，并同步修改下面的 DATABASE_URL
# 必填：是
DB_USER=user
DB_PASSWORD=pass
DB_NAME=app

# 应用连接字符串（host 为 compose 服务名 db）
# 必须与上面的 DB_USER / DB_PASSWORD / DB_NAME 保持一致：
#   postgresql://<DB_USER>:<DB_PASSWORD>@db:5432/<DB_NAME>
# ⚠️ 密码含 @ : / # 等特殊字符时必须 URL 编码（如 @ → %40），否则会解析失败导致认证错误
# ⚠️ POSTGRES_PASSWORD 只在数据卷「首次初始化」时生效；改密码后若报 28P01，
#    按 deployment/README.md「数据库密码认证失败」一节处理
# 必填：是
DATABASE_URL=postgresql://user:pass@db:5432/app

# --------------------------------------------
# 构建加速（可选；仅影响 docker 构建，不影响运行时）
# docker compose 会自动读取本文件里的这些变量
# --------------------------------------------

# npm 镜像源：优先用云厂商内网源（免流量、带宽大）
#   腾讯云 CVM：https://mirrors.cloud.tencent.com/npm/
#   华为云 ECS：https://repo.huaweicloud.com/repository/npm/
#   阿里云 ECS：https://mirrors.cloud.aliyuncs.com/npm/
#   通用公网：https://registry.npmmirror.com
# 默认：https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmmirror.com

# npm 主源失败时的备用源
NPM_FALLBACK_REGISTRY=https://registry.npmjs.org

# npm 并发连接数：公网源 6（避免限流）；换成内网源后可调到 16-32 明显提速
NPM_MAXSOCKETS=6

# 基础镜像：境内拉取 Docker Hub 很慢时，换成国内镜像仓库前缀
#   已实测可用：docker.m.daocloud.io / docker.1ms.run / hub.rat.dev
#   例：NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NODE_IMAGE=node:22-alpine

# PostgreSQL 基础镜像（同上，可换国内仓库前缀）
POSTGRES_IMAGE=postgres:16-alpine

# --------------------------------------------
# 行情数据配置
# --------------------------------------------

# 行情数据源
# 可选值：auto / eastmoney / tencent / sina / mock
#   auto      - 自动（默认）：东财为主源，失败自动切换备用源，全部不可用才回退模拟引擎
#   eastmoney - 东方财富 push2 / push2delay（含涨停池、炸板池、财务、概念板块）
#   tencent   - 腾讯财经 qt.gtimg.cn（备用批量行情，支持沪深京全部板块）
#   sina      - 新浪财经（备用批量行情与日K线）
#   mock      - 模拟数据（**仅离线演示用**，不是真实行情）
# 默认值：auto
# 必填：否
MARKET_DATA_SOURCE=auto

# 行情刷新间隔，单位毫秒（真实数据源建议 >= 3000，过小会触发数据源限流）
# 默认值：5000
# 必填：否
REFRESH_INTERVAL_MS=5000

# 全市场快照刷新间隔，单位毫秒（东财列表每页上限 100 条，全 A 约 5900 只需分页拉取）
# 默认值：60000
# 必填：否
FULL_SNAPSHOT_INTERVAL_MS=60000

# 最大监控股票数量（真实全 A 股约 5900 只，默认 8000 可全量覆盖）
# 默认值：8000
# 必填：否
MAX_STOCKS=8000

# 说明：行情为真实数据（东方财富 / 腾讯 / 新浪），股票池覆盖沪市主板、深市主板、
# 创业板、科创板、北交所全部号段；GET /api/market-data/market-coverage 可查看覆盖情况。
# 仅当显式设置为 mock，或所有真实源都不可用时，才回退到模拟引擎。

# --------------------------------------------
# WebSocket 配置
# --------------------------------------------

# 是否启用 WebSocket 实时推送
# 当前版本暂未支持，保持 false
# 默认值：false
# 必填：否
ENABLE_WEBSOCKET=false

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 日志级别
# 可选值：error / warn / info / debug / verbose
# 默认值：info
# 必填：否
LOG_LEVEL=info

# --------------------------------------------
# 安全配置
# --------------------------------------------

# 每分钟限流请求数（按 IP）
# 超过限制将返回 429 Too Many Requests
# 默认值：100
# 必填：否
RATE_LIMIT_REQUESTS=100

# Session 加密密钥
# 生产环境请务必修改为长随机字符串
# 生成方式：openssl rand -hex 32
# 默认值：无
# 必填：是（生产环境）
SESSION_SECRET=change_me_to_a_long_random_string

# CORS 允许的源
# 多个源用逗号分隔，允许所有用 *
# 默认值：*
# 必填：否
CORS_ORIGIN=*
