# ============================================
# 盘中异动监控系统 - 环境变量配置示例
# 使用方法：复制为 .env 后修改对应值
#   cp .env.example .env
# ============================================

# --------------------------------------------
# 基础服务配置
# --------------------------------------------

# 服务监听端口
# 默认值：3000
# 必填：否
PORT=3000

# 运行环境
# 可选值：production / development
# 默认值：production
# 必填：否
NODE_ENV=production

# 数据库连接字符串
# 格式：postgresql://<user>:<password>@<host>:<port>/<database>
# Docker Compose 部署时 host 为服务名 db
# 默认值：无
# 必填：是（使用数据库功能时）
DATABASE_URL=postgresql://user:pass@db:5432/app

# --------------------------------------------
# 行情数据配置
# --------------------------------------------

# 行情数据源
# 可选值：mock / eastmoney / tencent
#   mock     - 模拟数据（开发/演示用，无需网络）
#   eastmoney - 东方财富 push2 接口（推荐生产用）
#   tencent  - 腾讯财经接口（备用）
# 默认值：mock
# 必填：否
MARKET_DATA_SOURCE=mock

# 行情刷新间隔，单位毫秒
# 建议值：1000 - 5000
# 默认值：1000
# 必填：否
REFRESH_INTERVAL_MS=1000

# 最大监控股票数量
# 用于限制内存占用和请求频率
# 默认值：200
# 必填：否
MAX_STOCKS=200

# --------------------------------------------
# WebSocket 配置
# --------------------------------------------

# 是否启用 WebSocket 实时推送
# 当前版本暂未支持，保持 false
# 默认值：false
# 必填：否
ENABLE_WEBSOCKET=false

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 日志级别
# 可选值：error / warn / info / debug / verbose
# 默认值：info
# 必填：否
LOG_LEVEL=info

# --------------------------------------------
# 安全配置
# --------------------------------------------

# 每分钟限流请求数（按 IP）
# 超过限制将返回 429 Too Many Requests
# 默认值：100
# 必填：否
RATE_LIMIT_REQUESTS=100

# Session 加密密钥
# 生产环境请务必修改为长随机字符串
# 生成方式：openssl rand -hex 32
# 默认值：无
# 必填：是（生产环境）
SESSION_SECRET=change_me_to_a_long_random_string

# CORS 允许的源
# 多个源用逗号分隔，允许所有用 *
# 默认值：*
# 必填：否
CORS_ORIGIN=*
